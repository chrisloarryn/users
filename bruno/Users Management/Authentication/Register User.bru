meta {
  name: "Register User"
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno User",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}",
    "phones": [
      {
        "number": "123456789",
        "cityCode": "1",
        "countryCode": "56"
      }
    ]
  }
}

script:post-response {
  const responseStatus = res.getStatus();
  const responseBody = res.getBody();

  if (responseStatus === 201 && responseBody) {
    if (responseBody.accessToken) {
      bru.setEnvVar("jwt", responseBody.accessToken);
    }

    if (responseBody.user?.id) {
      bru.setEnvVar("userId", responseBody.user.id);
    }

    if (responseBody.user?.email) {
      bru.setEnvVar("userEmail", responseBody.user.email);
    }
  }
}

settings {
  encodeUrl: true
}
