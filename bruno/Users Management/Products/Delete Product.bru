meta {
  name: "Delete Product"
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/products/{{productId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

script:post-response {
  if (res.status === 204) {
    bru.setEnvVar("productId", "", { persist: false });
  }
}

settings {
  encodeUrl: true
}
