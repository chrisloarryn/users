meta {
  name: "Create Product"
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

body:json {
  {
    "name": "Sample Product",
    "price": 12.34
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("productId", res.body.id, { persist: false });
  }
}

settings {
  encodeUrl: true
}
